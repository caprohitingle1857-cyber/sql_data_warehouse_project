/* 
===================================================
creat database and schemas
===================================================
Script purpose:
              This script creates a new database nameed 'DataWarehouse' after checking if it already exists.
              If the database exists, it is dropped and recreated. Additionally, the script sets up three schemas
              within the database:'bronz' 'silver' and 'gold'.
WARNING:Running this script will drop the entire 'DataWarehose' database if it exists.
All data will be permanently deleted.Proceed with caution and have backup before running it.*/


--Drop and recreate the 'DataWarehouse' database
IF EXISTS (SELECT 1 FROM sys.database WHERE name= 'Datawarehouse')
BEGIN
     ALTER DATABASE DataWarehouse SET SINGLE_USER WITH ROLLBACK IMMEDIATE;
     DROP DATABASE DataWarehouse;
 END;
 GO
 CREATE DATABASE DataWarehouse;
 GO
CREATE SCHEMA bronze;
GO
CREATE SCHEMA silver;
GO
CREATE SCHEMA gold;
GO
